                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<integer>",
                      "key": "id",
                      "description": "(Required) The ID of the attachment to be linked with the attachment element"
                    }
                  ]
                },
                "method": "PUT",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"token\": \"YOUR TOKEN IS HERE\",\n  \"item\": {\n    \"element_id\": \"<integer>\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
